# Токен от @BotFather. Никому не показывайте и не выкладывайте в репозиторий.
BOT_TOKEN=
# Адрес игры на хостинге с HTTPS, без / в конце. Например, GitHub Pages:
WEBAPP_URL=https://afonineureca.github.io/kriminalist
# Куда бот присылает истории на проверку: id группы модераторов (начинается с -100) или ваш личный id.
MOD_CHAT_ID=
# id модераторов через запятую. Свой id можно узнать командой /myid в боте.
ADMIN_IDS=
# Файл базы данных (по умолчанию рядом с bot.py)
DB_PATH=kontur.db
